# Local development defaults to deterministic fixture evidence.
INVESTIGATION_MODE=fixture
PORT=8787

# Required for the live hackathon runtime.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_MODEL=gemini-3.7-flash
PARALLEL_API_KEY=

# Production must explicitly opt into live mode.
APP_ENV=development
